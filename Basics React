// input part :
import React,{useState} from 'react'

const CreateTodo = () => {
    const [count,setCount]=useState(0); // improve above 3 line to 1 line => Array desturcting 
   const [input,setInput] =useState(" ")
    const handleClick=()=>{
        setCount(count+1);   
    };
    const handleChange=(event)=>{
      setInput(event.target.value);
    };
  return (
    <React.Fragment>
    <input type="text" onChange={handleChange} />
    <h1>State Changes:  {count} </h1>
    <button onClick={handleClick} value='Add Task'>Add Task</button>
    <h1>Input is:{input} </h1>
    </React.Fragment>
  );
};
// map method + how to display list :
import React,{useState} from 'react'

const CreateTodo = () => {
    const [count,setCount]=useState(0); // improve above 3 line to 1 line => Array desturcting 
   const [input,setInput] =useState(" ")
    const handleClick=()=>{
        setCount(count+1);   
    };
    const handleChange=(event)=>{
      setInput(event.target.value);
    };
    const tasks=["Task1","Task2","Task3","Task4"];
  return (
    <React.Fragment>
    <input type="text" onChange={handleChange} />
    <h1>State Changes:  {count} </h1>
    <button onClick={handleClick} value='Add Task'>Add Task</button>
    <h1>Input is:{input} </h1>
    <ul>
         {/* remember when we using map method in react we always need to pass unique key */}
        {
            tasks.map(task=>
                <li key={task}>{task} </li> // u cant display this list again in this application
            )
        }
    </ul>
    </React.Fragment>
  );
};

export default CreateTodo
