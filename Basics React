import React from 'react'

const CreateTodo = () => {
    const task=2;
    const hideButton=false;
    const countTask=()=>{
     return (task==0)? "No task availabe" : `Task: ${task}`;
    };

  return (
    <React.Fragment>
    <h1> {countTask()} </h1>
    <button disabled={hideButton} value='Add Task'>Add Task</button>
    </React.Fragment>
  );
};

export default CreateTodo
