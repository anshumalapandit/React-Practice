filter method
// it is used to filter array 
// its is used to remove the items from existing array
// remember its always return a new Array
const ages=[1,2,3,4,56,99,44];
console.log(ages);
// now i want to only those ages which are 18+
const adults=ages.filter((age)=>{
    return age>18;
});
console.log(adults);
// also remember also we can remove return and curly bracket bcoz only 1 statement
const adults_=ages.filter((age)=> age>18); // its looks simpler
// remember just - the element will pass this conditon just get added to my new arr
